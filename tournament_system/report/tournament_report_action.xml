<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_report_tournaments_results" model="ir.actions.report">
        <field name="name">Results of Tournament</field>
        <field name="model">event.tournament</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tournament_system.report_tournaments_results_template</field>
        <field name="report_file">tournament_system.report_tournaments_results_template</field>
        <field name="print_report_name">'Results - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_event_tournament"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_tournament_category_results" model="ir.actions.report">
        <field name="name">Results of Category</field>
        <field name="model">event.tournament.category</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tournament_system.report_tournament_category_template</field>
        <field name="report_file">tournament_system.report_tournament_category_template</field>
        <field name="print_report_name">'Category Results - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_event_tournament_category"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_tournament_participant" model="ir.actions.report">
        <field name="name">Participant Profile</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tournament_system.report_tournament_participant_template</field>
        <field name="report_file">tournament_system.report_tournament_participant_template</field>
        <field name="print_report_name">'Participant - %s' % (object.name)</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_tournament_score" model="ir.actions.report">
        <field name="name">Score Report</field>
        <field name="model">event.tournament.score</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tournament_system.report_tournament_score_template</field>
        <field name="report_file">tournament_system.report_tournament_score_template</field>
        <field name="print_report_name">'Score Report'</field>
        <field name="binding_model_id" ref="model_event_tournament_score"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
