<odoo>
    <template id="report_tournaments_results_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="tournament">
                <t t-call="web.external_layout">
                <div class="page">
                    <h1>
                        Results of Tournament: <span t-field="tournament.name"/>
                    </h1>
                    <div class="row mt-4">
                        <h3 class="col-6">start_date: <span t-field="tournament.start_date"/></h3>
                        <h3 class="col-6">end_date: <span t-field="tournament.end_date"/></h3>
                    </div>
                    <div class="row mt-4">
                        <h3 class="col-6">Categories:</h3>
                        <ul>
                            <t t-foreach="tournament.mapped('category_ids')" t-as="category">
                                <li><span t-field="category.name"/></li>
                            </t>
                        </ul>
                    </div>
                    <div class="row mt-4">
                        <h3 class="col-6">Company: <span t-field="tournament.company_id.name"/></h3>
                    </div>
                    <table class="table table-sm mt-4">
                        <theader>
                            <tr>
                                <th>Participant</th>
                                <th>Category</th>
                                <th>Points</th>
                            </tr>
                        </theader>
                        <tbody>
                            <t t-foreach="tournament.category_ids.mapped('participant_ids')" t-as="participant">
                                <tr>
                                    <td><span t-field="participant.name"/></td>
                                    <td><span t-field="participant.tournament_category_id.name"/></td>
                                    <td><span t-field="participant.score_ids[0].score"/></td> 
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
                </t>
            </t>
        </t>
    </template>
</odoo>