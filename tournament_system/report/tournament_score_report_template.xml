<odoo>
    <template id="report_tournament_score_template">
        <t t-call="web.html_container">
            <t t-call="tournament_system.tournament_external_layout">
                <div class="page">
                    <h1>Score Report</h1>

                    <div class="row mt-2">
                        <div class="col-6">
                            <strong>Total Records:</strong>
                            <span t-esc="len(docs)"/>
                        </div>
                    </div>

                    <table class="table table-sm table-bordered mt-4">
                        <thead class="thead-light">
                            <tr>
                                <th>Tournament</th>
                                <th>Category</th>
                                <th>Participant</th>
                                <th>Judge</th>
                                <th class="text-center" style="width:80px;">Score</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="score">
                                <tr>
                                    <td><span t-field="score.tournament_id.name"/></td>
                                    <td><span t-field="score.tournament_category_id.name"/></td>
                                    <td><span t-field="score.participant_id.name"/></td>
                                    <td><span t-field="score.judge_id.name"/></td>
                                    <td class="text-center font-weight-bold">
                                        <span t-field="score.score"/>
                                    </td>
                                    <td><span t-field="score.notes"/></td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr class="bg-light">
                                <td colspan="4" class="text-right font-weight-bold">Total Score Sum:</td>
                                <td class="text-center font-weight-bold">
                                    <span t-esc="sum(docs.mapped('score'))"/>
                                </td>
                                <td/>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
