<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="event_tournament_score_tree_view" model="ir.ui.view">
        <field name="name">event.tournament.score.tree.panel</field>
        <field name="model">event.tournament.score</field>
        <field name="arch" type="xml">
            <tree string="Panel of points">
                <field name="registration_id" />
                <field name="score" />
                <field name="notes" optional="show"/>
                <field name="judge_id" invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="event_tournament_score_form_view" model="ir.ui.view">
        <field name="name">event.tournament.score.form</field>
        <field name="model">event.tournament.score</field>
        <field name="arch" type="xml">
            <form string="Score Form">
                <sheet>
                    <div class="oe_title">
                        <h1>Score Form</h1>
                    </div>
                    <group>
                        <field name="registration_id"/>
                        <field name="score"/>
                    </group>
                    <group>
                        <field name="notes"/>
                        <field name="judge_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>