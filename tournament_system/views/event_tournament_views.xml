<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="event_tournament_view_form" model="ir.ui.view">
        <field name="name">event.tournament.form</field>
        <field name="model">event.tournament</field>
        <field name="arch" type="xml">
            <form string="Tournament">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_in_progress" string="Pass a judge" type="object" class="oe_highlight" invisible="state != 'confirm'"/>
                    <button name="action_done" string="Generate Points" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_report_pdf" string="Generate Report PDF" type='object' class="oe_highlight" invisible="state != 'done'"/>
                    <button name="action_open_cancel_wizard" string="Cancel Tournament" type="object" class="btn-danger" invisible="state in ('done', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm,in_progress,done,cancel"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Tournament</h1>
                        <field name="name" placeholder="Ej. Tournament of Soccer" readonly="state == 'cancel'"/>
                    </div>
                    <group>
                        <group>
                            <field name="start_date" readonly="state == 'cancel'"/>
                            <field name="end_date" readonly="state == 'cancel'"/>
                        </group>
                        <group>
                            <field name="company_id" readonly="state == 'cancel'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Categories" name="categories">
                            <field name="category_ids" readonly="state == 'cancel'"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="event_tournament_view_tree" model="ir.ui.view">
        <field name="name">event.tournament.tree</field>
        <field name="model">event.tournament</field>
        <field name="arch" type="xml">
            <tree string="Tournament System">
                <field name="state"/>
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="category_ids" widget="many2many_tags"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>
</odoo>
